{
  "name": "ticketscan",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:push": "turbo run db:push --filter=@ticketscan/db",
    "db:studio": "turbo run db:studio --filter=@ticketscan/db",
    "db:generate": "turbo run db:generate --filter=@ticketscan/db",
    "deploy:preview": "turbo run deploy:preview",
    "deploy:prod": "turbo run deploy:prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}